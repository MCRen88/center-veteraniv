# Supabase Backend Configuration (frontend, local development)
# For production server with HTTPS/Nginx reverse proxy, VITE_SUPABASE_URL can be set to the server domain, e.g. https://veteran.zoippo.net.ua
VITE_SUPABASE_URL=http://localhost:54329
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Never put the service_role key in a VITE_* variable: Vite embeds those into the public JS bundle.
# The service_role key belongs only to the api service (SERVICE_ROLE_KEY in .env.production.example).
