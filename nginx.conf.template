# =========================================================================
# Nginx site configuration for LMS Portal (lms.ele.zp.ua)
# =========================================================================
# Install:
#   sudo cp nginx.conf.template /etc/nginx/sites-available/lms.conf
#   sudo ln -sf /etc/nginx/sites-available/lms.conf /etc/nginx/sites-enabled/lms.conf
#   sudo install -D -m 644 nginx-security-headers.conf /etc/nginx/snippets/lms-security-headers.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# Upstreams (docker-compose.yml, all bound to 127.0.0.1):
#   Kong  KONG_PORT=54330 -> /rest/v1 (PostgREST), /auth/v1 (GoTrue)
#   api   API_PORT=54474  -> /api/admin, /api/otp, /api/health
# The stack has no storage, functions or realtime services, so those paths are not proxied.
# =========================================================================

# Rate-limit zones (http context: this file is included from http {} via sites-enabled).
limit_req_zone $binary_remote_addr zone=lms_otp:10m   rate=6r/m;
limit_req_zone $binary_remote_addr zone=lms_auth:10m  rate=30r/m;
limit_req_zone $binary_remote_addr zone=lms_admin:10m rate=60r/m;

# HTTP -> HTTPS
server {
    listen 80;
    server_name lms.ele.zp.ua;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name lms.ele.zp.ua;

    root /opt/lms-portal/dist;
    index index.html;

    ssl_certificate /etc/letsencrypt/live/lms.ele.zp.ua/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lms.ele.zp.ua/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    server_tokens off;
    limit_req_status 429;

    # Security headers. add_header in a location replaces the server-level ones,
    # so every location with its own add_header includes this file again.
    include /etc/nginx/snippets/lms-security-headers.conf;

    # Frontend (single page application)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html must not be cached: it points to the current hashed bundle
    # (after a key rotation the old bundle carries an invalid anon key).
    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/lms-security-headers.conf;
    }

    # PostgREST via Kong. Applications carry scanned documents
    # (up to 30 MB, base64-encoded), hence the body size.
    location ^~ /rest/v1/ {
        proxy_pass http://127.0.0.1:54330/rest/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50M;
    }

    # GoTrue via Kong. Rate-limited against password guessing.
    location ^~ /auth/v1/ {
        limit_req zone=lms_auth burst=20 nodelay;
        proxy_pass http://127.0.0.1:54330/auth/v1/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Server-side api service: admin user management (admin JWT required).
    location ^~ /api/admin/ {
        limit_req zone=lms_admin burst=30 nodelay;
        proxy_pass http://127.0.0.1:54474;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Server-side api service: email verification codes for applications.
    # The api service also limits codes per email and per IP (X-Real-IP).
    location ^~ /api/otp/ {
        limit_req zone=lms_otp burst=5 nodelay;
        proxy_pass http://127.0.0.1:54474;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:54474;
        proxy_set_header Host $host;
        access_log off;
    }

    # Any other /api/ path: 404 instead of the SPA fallback.
    location ^~ /api/ {
        return 404;
    }

    # Static assets: hashed file names, safe to cache.
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|ttf|svg|webp)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/lms-security-headers.conf;
        access_log off;
    }

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml+rss image/svg+xml;
    gzip_min_length 256;

    access_log /var/log/nginx/lms_access.log;
    error_log /var/log/nginx/lms_error.log;
}
