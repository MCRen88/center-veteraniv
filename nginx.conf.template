# =========================================================================
# 🌐 Nginx Server Configuration Template for LMS Portal (lms.ele.zp.ua)
# =========================================================================
# Copy this configuration to your Nginx configuration folder (e.g. /etc/nginx/sites-available/lms.conf)
# and link it to /etc/nginx/sites-enabled/lms.conf

# =========================================================================
# OPTION A: Deployment on a CUSTOM SUBDOMAIN sharing standard ports 80/443
# (Recommended: Nginx virtual hosts will handle routing automatically without conflicts)
# =========================================================================

# HTTP Redirect to HTTPS
server {
    listen 80;
    server_name lms.ele.zp.ua; # <-- Replace with your subdomain
    return 301 https://$host$request_uri;
}

# Rate-limit zones (http context: this file is included from http {} via sites-enabled)
limit_req_zone $binary_remote_addr zone=lms_otp:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=lms_tts:10m rate=60r/m;

# Main HTTPS Server
server {
    listen 443 ssl http2;
    server_name lms.ele.zp.ua; # <-- Replace with your subdomain

    root /opt/lms-portal/dist; # <-- Path to your built frontend files
    index index.html;

    # SSL Certificates (Update paths to your certbot certificates)
    ssl_certificate /etc/letsencrypt/live/rating.ele.zp.ua/fullchain.pem; # <-- Replace with your cert path
    ssl_certificate_key /etc/letsencrypt/live/rating.ele.zp.ua/privkey.pem; # <-- Replace with your cert key path
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Security headers. add_header in a location replaces these, so locations that
    # add their own headers include this file again (see the static assets block).
    include /etc/nginx/snippets/lms-security-headers.conf;

    location / {
        # Serve static assets first, fallback to index.html for React Router routing
        try_files $uri $uri/ /index.html;
    }

    # Proxy REST API to local Kong port 54330 (avoids conflict with rating's 54321)
    # Applications carry scanned documents (up to 30 MB, base64-encoded), hence the body size.
    location ^~ /rest/v1/ {
        proxy_pass http://127.0.0.1:54330/rest/v1/;
        proxy_set_header Host $host;
        client_max_body_size 50M;
    }

    # Server-side api (docker service "api", API_PORT): admin user management and email codes
    location ^~ /api/admin/ {
        proxy_pass http://127.0.0.1:54474;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
    location ^~ /api/otp/ {
        limit_req zone=lms_otp burst=5 nodelay;
        proxy_pass http://127.0.0.1:54474;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Proxy Google Translate TTS to bypass CORS/referer blocks.
    # Rate-limited per client so the server cannot be used as a free TTS relay.
    location ^~ /api/tts {
        limit_req zone=lms_tts burst=20 nodelay;
        proxy_pass https://translate.google.com/translate_tts;
        proxy_set_header Referer "https://translate.google.com/";
        proxy_set_header User-Agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36";
        proxy_ssl_server_name on;
    }

    # Proxy Auth API to local Kong port 54330
    location ^~ /auth/v1/ {
        proxy_pass http://127.0.0.1:54330/auth/v1/;
        proxy_set_header Host $host;
    }

    # Static Assets Caching
    location ~* \.(?:ico|css|js|gif|jpe?g|png|woff2?|ttf|svg|webp)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/lms-security-headers.conf;
        access_log off;
    }

    # Compression Settings
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml+rss image/svg+xml;
    gzip_min_length 256;

    # Separate Log Files for LMS Portal
    access_log /var/log/nginx/lms_access.log;
    error_log /var/log/nginx/lms_error.log;
}


