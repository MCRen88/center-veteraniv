# ===============================================
# LMS Portal - Production Environment Template
# Generate real values with: node generate-prod-keys.js
# Never commit the filled-in .env file.
# ===============================================

# [CRITICAL] Strong production-grade credentials
POSTGRES_PASSWORD=generate-a-strong-random-password-here
JWT_SECRET=generate-a-strong-jwt-secret-at-least-32-characters-long

# Keys signed with JWT_SECRET (see generate-prod-keys.js)
ANON_KEY=your-anon-key-here
SERVICE_ROLE_KEY=your-service-role-key-here

# --- Non-Standard Ports for Server Deployment (bound to 127.0.0.1 only) ---
# Chosen to avoid conflicts with rating.ele.zp.ua (Kong: 54321) and other services
DB_PORT=54332
STUDIO_PORT=54331
KONG_PORT=54330
API_PORT=54474

# --- Frontend & Supabase URLs for docker-compose ---
SITE_URL=https://lms.ele.zp.ua
SUPABASE_PUBLIC_URL=https://lms.ele.zp.ua

# --- api service: email verification codes via SMTP (Gmail) ---
# Gmail requires an App Password (Google Account -> Security -> App passwords), not the account password.
OTP_SECRET=generate-a-random-secret-at-least-32-characters-long
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM_NAME=Кваліфікаційний центр КЗ «ЗОІППО» ЗОР

# --- Client-side Vite variables (embedded into the public JS bundle!) ---
# Only public values here. Never the service_role key.
VITE_SUPABASE_URL=https://lms.ele.zp.ua
VITE_SUPABASE_ANON_KEY=your-anon-key-here
